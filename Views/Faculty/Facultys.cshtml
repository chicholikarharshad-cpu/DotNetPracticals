@{
    ViewData["Title"] = "Facultys";
}




<style>
    .tableContainer {
        margin-top: 2rem;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    table {
        width: 75%;
        padding: 0.5rem;
        text-align: center;

    }

    tr,
    th,
    td {
        border: 1px solid black;
        padding: 0.5rem;
    }

    thead {
        background-color: grey;
        color: white;
    }

    tr:hover {
        background-color: rgb(204, 204, 204);
        color: white;

    }
</style>




<div
    class="tableContainer font-serif w-full min-h-screen max-h-full border-2 mt-10 p-10 rounded-lg grid grid-cols-3 gap-2 bg-[#8BF5F5]">


    <table>
        <thead>
            <tr>
                <th>Sr. No.</th>
                <th>Faculty</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>


            

                <tr>
                    <td>1</td>
                    <td>Gaurang Pande</td>
                    <td class="flex justify-center gap-2">



                        <a asp-action="Details" asp-controller="Faculty" class="text-blue-600 hover:text-blue-800 action-btn">
                            <p>Details</p>
                        </a>

                        |

                        <a asp-action="SubjectOffaculty" asp-controller="Faculty" class="text-yellow-600 hover:text-yellow-800 action-btn">
                            <p>Subject</p>
                        </a>

                        |

                        <a asp-action="ScheduleOfFaculty" asp-controller="Faculty" class="text-red-600 hover:text-red-800 action-btn">
                            <p>Schedule</p>
                        </a>

                        

                            
                    </td>
                </tr>
            
        </tbody>
    </table>
</div>
