@{
    ViewData["Title"] = "Home";
}

<style>

</style>



<div
    class="main font-serif w-full max-h-full min-h-screen border-2 mt-10 p-10 rounded-lg grid grid-cols-3 gap-2 bg-[#8BF5F5]">

    
    <a asp-action="Students" asp-controller="Student">

        <div
            class="hover:bg-[#70E5E5] hover:shadow-lg hover:scale-105 transition duration-300 border-1 bg-[#B9FAFA] w-full h-50 p-5 grid grid-cols-[35%_65%] gap-2 items-center justify-center rounded-lg">
            <div class="w-full h-full grid-1">
                <img src="/images/student.png" alt="Student" class="w-full h-full object-cover rounded">
            </div>

            <div class="text">
                <div class="title text-4xl font-bold border-b-4">Students</div>
                <div class="lengthOfStudent text-4xl font-bold">129</div>
            </div>
        </div>
    </a>



