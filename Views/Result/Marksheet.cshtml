@{
    ViewData["Title"] = "Marksheet";


}



<style>
    .tableContainer {
        margin-top: 2rem;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    table {
        width: 75%;
        padding: 0.5rem;
        text-align: center;

    }

    tr,
    th,
    td {
        border: 1px solid black;
        padding: 0.5rem;
    }

    thead {
        background-color: grey;
        color: white;
    }

    tr:hover {
        background-color: rgb(204, 204, 204);
        color: white;

    }
</style>




<div class="main">
    <div class="tableContainer">
        <table>
            <thead>
                <tr>
                    <th>Subject</th>
                    <th>Max Mark</th>
                    <th>Mark Obtained</th>
                    <th>Grade</th>
                    <th>Credits</th>
                </tr>
            </thead>
            <tbody>

                <tr>
                    <td>Dotnet</td>
                    <td>100</td>
                    <td>97</td>
                    <td>A</td>
                    <td>4.5</td>
                </tr>

                <tr>
                    <td>Java</td>
                    <td>100</td>
                    <td>91</td>
                    <td>A</td>
                    <td>4.1</td>
                </tr>

                <tr>
                    <td>Python</td>
                    <td>100</td>
                    <td>95</td>
                    <td>A</td>
                    <td>5</td>
                </tr>

                <tr>
                    <td>PHP</td>
                    <td>100</td>
                    <td>93</td>
                    <td>A</td>
                    <td>4</td>
                </tr>

                <tr>
                    <td>Database</td>
                    <td>100</td>
                    <td>98</td>
                    <td>A</td>
                    <td>5</td>
                </tr>



                <tr>
                    <td colspan="2">Totle Mark : 474/500</td>
                    <td>SGPA:4.9</td>
                    <td colspan="2">Result: Pass</td>
                </tr>

            </tbody>
        </table>
    </div>
</div>