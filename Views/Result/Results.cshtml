@{
    ViewData["Title"] = "Results";
}


@using Microsoft.AspNetCore.Components.Forms
@{
    ViewData["Title"] = "Attandance";
}




<div
    class="main font-serif w-full max-h-screen min-h-full border-2 mt-10 p-10 rounded-lg grid grid-cols-3 gap-2 bg-[#8BF5F5]">

    
    
    <a asp-action="Marksheet" asp-controller="Result">

        <div
            class="hover:bg-[#70E5E5] hover:shadow-lg hover:scale-105 transition duration-300 border-1 bg-[#B9FAFA] w-full h-50 p-5 grid grid grid-cols-[35%_65%] gap-2 items-center justify-center rounded-lg">
            <div class="w-full h-full grid-1">
                <img src="/images/markSheet.png" alt="Courses" class="w-full h-full object-cover rounded">
            </div>

            <div class="text">
                <div class="title text-4xl font-bold border-b-4">Marksheets</div>
            </div>
        </div>
    </a>



    <a asp-action="Grades" asp-controller="Result">

        <div
            class="hover:bg-[#70E5E5] hover:shadow-lg hover:scale-105 transition duration-300 border-1 bg-[#B9FAFA] w-full h-50 p-5 grid grid grid-cols-[35%_65%] gap-2 items-center justify-center rounded-lg">
            <div class="w-full h-full grid-1">
                <img src="/images/grades.png" alt="Courses" class="w-full h-full object-cover rounded">
            </div>

            <div class="text">
                <div class="title text-4xl font-bold border-b-4">Grades</div>
            </div>
        </div>
    </a>


    <a asp-action="RankList" asp-controller="Result">

        <div
            class="hover:bg-[#70E5E5] hover:shadow-lg hover:scale-105 transition duration-300 border-1 bg-[#B9FAFA] w-full h-50 p-5 grid grid-cols-[35%_65%] gap-2 items-center justify-center rounded-lg">
            <div class="w-full h-full grid-1">
                <img src="/images/rankList.png" alt="Student" class="w-full h-full object-cover rounded">
            </div>

            <div class="text">
                <div class="title text-4xl font-bold border-b-4">Rank List</div>
            </div>
        </div>
    </a>

</div>
