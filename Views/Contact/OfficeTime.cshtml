@{
    ViewData["Title"] = "OfficeTime";
}


<div class="main">

    <div>
        Administrative Office Timings: e.g., Monday to Friday: 8:00 AM – 3:00 PM; Saturday: 9:00 AM – 1:00 PM.
    </div>

    <div>
        Principal Meeting Hours: Scheduled time to meet the Principal (e.g., 10:00 AM – 12:00 PM by prior appointment).
    </div>

    <div>
        Fee Deposit Timings: Days and hours for fee payment (if accepted in cash or at the counter).
    </div>

    <div>
        Closed Days: Information regarding office closure on Sundays and public holidays/festivals.
    </div>
</div>