@{
    ViewData["Title"] = "All Students";
}


<style>



.tableContainer {
  margin-top: 2rem;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

table {
  width: 75%;
  padding: 0.5rem;
  text-align: center;

}

tr,
th,
td {
  border: 1px solid black;
  padding: 0.5rem;
}

thead {
  background-color: grey;
  color: white;
}

tr:hover {
  background-color: rgb(204, 204, 204);
  color: white;

}
    .action-btn {
        margin: 0 4px;
        cursor: pointer;
        border: none;
        background: none;
    }
</style>




<div class="tableContainer font-serif w-full min-h-screen max-h-full border-2 mt-10 p-10 rounded-lg grid grid-cols-3 gap-2 bg-[#8BF5F5]">


    <table>
        <thead>
            <tr>
                <th>Sr. No.</th>
                <th>Name</th>   
                <th>Action</th> 
            </tr>
        </thead>

        <tbody>


            @foreach (var student in ViewBag.Students)
            {

                <tr>
                    <td>@student.Index</td>
                    <td>@student.FullName</td>
                    <td class="flex justify-center gap-2">



                        <a asp-action="Profile" asp-controller="Student" asp-route-Email="@student.Email" title="View
                    Details" class="text-blue-600 hover:text-blue-800 action-btn">
                            <p>Profile</p> 
                    </a>

                    |

                    <a asp-action="Edit" asp-controller="Student" asp-all-route-id="@student.Email" title="Edit"
                    class="text-yellow-600 hover:text-yellow-800 action-btn">
                            <p>Edit</p>
                        </a>

                        |

                        <a asp-action="Delete" asp-controller="Student" asp-all-route-id="@student.Email" title="Delete"
                    class="text-red-600 hover:text-red-800 action-btn">
                            <p>Delete</p>
                        </a>  

                        |

                        <a asp-action="IDCard" asp-controller="Student" asp-route-Email="@student.Email" title="ID Card"
                           class="text-purple-600 hover:text-purple-800 action-btn">

                         <p>IDCard</p>
                        </a>

                        

                            
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
