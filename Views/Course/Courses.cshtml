@{
    ViewData["Title"] = "All Courses";
}


<style>
    .tableContainer {
        margin-top: 2rem;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    table {
        width: 100%;
        padding: 0.5rem;
        text-align: center;

    }

    tr,
    th,
    td {
        border: 1px solid black;
        padding: 0.5rem;
    }

    thead {
        background-color: grey;
        color: white;
    }

    tr:hover {
        background-color: rgb(204, 204, 204);
        color: white;

    }

    .action-btn {
        margin: 0 4px;
        cursor: pointer;
        border: none;
        background: none;
    }
</style>



<div
    class="tableContainer font-serif w-full min-h-screen max-h-full border-2 mt-10 p-10 rounded-lg grid grid-cols-3 gap-2 bg-[#8BF5F5]">


    <table>
        <thead>
            <tr>
                <th>Sr. No.</th>
                <th>Name</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>


            @foreach (var course in ViewBag.Courses)
            {

            
                <tr>
                    <td>@course.Index</td>
                    <td>@course.courseName</td>
                    <td class="flex justify-center gap-2">



                        <a asp-controller="Course" asp-action="CourseDetails" asp-route-id="@course.Index"
                           class="text-purple-600 hover:text-purple-800">
                            <p>Courses</p>
                        </a>


                        |


                        <a asp-controller="Course" asp-action="Subjects" asp-route-courseName="@course.courseName"
                           class="text-yellow-600 hover:text-yellow-800">
                            <p>Subject</p>
                        </a>

                        |

        

                        <a asp-controller="Course" asp-action="Timetables" asp-route-id="@course.Index"
                           class="text-red-600 hover:text-red-800">
                            TimeTable
                        </a>

                    </td>

 
                </tr>
            }

        </tbody>
    </table>
</div>



